# Copy these into .env.local. Every EXPO_PUBLIC_ value is compiled into the app and is public by design.
# Never give any other Supabase secret an EXPO_PUBLIC_ name.

# Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# This game's id: select id from public.games where slug = 'puzzlewala';
EXPO_PUBLIC_GAME_UUID=
